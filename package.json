{
  "name": "mis-design",
  "license": "MIT",
  "author": "PT. Sat Nusapersada, Tbk - MIS Dept",
  "description": "A reusable React component library built with Tailwind CSS.",
  "keywords": [],
  "version": "1.0.0",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint src/ test/ --max-warnings 0",
    "lint:fix": "eslint src/ test/ --fix",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "copy:assets": "cpy \"src/assets/**/*\" dist/assets -r",
    "copy:css": "cpy \"src/**/*.css\" dist --parents",
    "build:css": "tailwindcss -i ./src/input.css -o ./src/output.css --minify",
    "build:lib": "rimraf dist && yarn build:css && tsc -p tsconfig.build.json && tsc -p tsconfig.types.json && yarn copy:css && yarn copy:assets",
    "export": "node scripts/export.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type:check": "tsc --project tsconfig.json --pretty",
    "pre-commit": "lint-staged",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:all": "vitest run",
    "test:storybook": "vitest run --project storybook",
    "clean": "rimraf dist coverage storybook-static",
    "validate": "yarn lint && yarn type:check && yarn test && yarn format:check"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-router-dom": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "react-router-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@intevation/tiptap-extension-office-paste": "^0.1.2",
    "@tiptap/extension-color": "^3.20.5",
    "@tiptap/extension-highlight": "^3.20.5",
    "@tiptap/extension-image": "^3.20.5",
    "@tiptap/extension-link": "^3.20.5",
    "@tiptap/extension-placeholder": "^3.20.5",
    "@tiptap/extension-table": "^3.20.5",
    "@tiptap/extension-text-align": "^3.20.5",
    "@tiptap/extension-text-style": "^3.20.5",
    "@tiptap/extension-underline": "^3.20.5",
    "@tiptap/pm": "^3.20.5",
    "@tiptap/react": "^3.20.5",
    "@tiptap/starter-kit": "^3.20.5",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.20",
    "gsap": "^3.14.2",
    "react-intersection-observer": "^10.0.3",
    "react-pdf": "^10.4.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "use-debounce": "^10.1.0"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.28.5",
    "@chromatic-com/storybook": "^5.1.1",
    "@eslint/js": "^9.39.4",
    "@storybook/addon-docs": "10.3.3",
    "@storybook/addon-themes": "^10.3.3",
    "@storybook/addon-vitest": "10.3.3",
    "@storybook/react-vite": "10.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/gsap": "^3.0.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser": "^4.1.1",
    "@vitest/browser-playwright": "^4.1.1",
    "@vitest/coverage-v8": "^4.1.1",
    "autoprefixer": "^10.4.27",
    "cpy-cli": "^7.0.0",
    "css-loader": "^7.1.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-sonarjs": "^4.0.2",
    "eslint-plugin-storybook": "10.3.3",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "playwright": "^1.58.2",
    "postcss": "^8.5.8",
    "postcss-loader": "^8.2.1",
    "prettier": "3.8.1",
    "prop-types": "^15.8.1",
    "react-router-dom": "^7.13.2",
    "rimraf": "^6.1.3",
    "storybook": "10.3.3",
    "style-loader": "^4.0.0",
    "typescript": "5.9",
    "typescript-eslint": "^8.57.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.1"
  },
  "files": [
    "dist"
  ],
  "browserslist": [
    ">= 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead",
    "Chrome >= 80",
    "Edge >= 80",
    "Safari >= 13",
    "Firefox >= 78",
    "Electron >= 15"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dist/output.css": "./dist/output.css"
  }
}
